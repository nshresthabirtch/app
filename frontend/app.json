{
  "expo": {
    "name": "I'm Hungry",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.hungrytrip.w49eh7",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Say what you're hungry for, hands-free",
        "NSLocationWhenInUseUsageDescription": "Find tasty food spots near you",
        "NSCalendarsUsageDescription": "Add planned trip meals to your calendar",
        "NSCalendarsFullAccessUsageDescription": "Add planned trip meals to your calendar"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "package": "com.emergent.hungrytrip.w49eh7",
      "permissions": [
        "RECORD_AUDIO",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "READ_CALENDAR",
        "WRITE_CALENDAR"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      "expo-font",
      "expo-image",
      "expo-secure-store",
      "expo-web-browser",
      "expo-status-bar",
      "@react-native-vector-icons/material-design-icons",
      [
        "expo-audio",
        {
          "microphonePermission": "Say what you're hungry for, hands-free"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Find tasty food spots near you"
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "Add planned trip meals to your calendar"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}